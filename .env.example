# WhatsApp (servidor Node.js whatsapp-web.js)
# Local: VITE_WHATSAPP_API_URL=http://localhost:3001
# Produção (Railway/Render): VITE_WHATSAPP_API_URL=https://seu-app.up.railway.app
VITE_WHATSAPP_API_URL=http://localhost:3001

# URL pública do app (usada nos links do WhatsApp e nas OG tags)
VITE_APP_URL=https://app.visionbiz.com

# Supabase (frontend)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Variáveis das Edge Functions (configurar em Supabase > Settings > Edge Functions) ---

# Google OAuth
GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxx
GOOGLE_REDIRECT_URI=https://xxxxxxxxxxxx.supabase.co/functions/v1/storage-oauth-callback

# URL do frontend (para redirecionamento após OAuth)
FRONTEND_URL=https://app.visionbiz.com

# Chave para assinar o state OAuth (mínimo 32 chars, aleatório)
STATE_SIGNING_KEY=change-me-to-a-random-secret-at-least-32-chars

# Chave para criptografar tokens no banco (mínimo 32 chars, aleatório)
ENCRYPTION_KEY=change-me-to-a-different-random-secret-32-chars
